# The API the app calls. Local development runs the Rails API on port 3000;
# production builds use https://api.theartexch.com/api/v1 (set by the deploy).
VITE_API_URL=http://localhost:3000/api/v1

# Accounts (sign in, sign up, collections) are off until the API supports
# sign-in for imported users. Set to true to work on them locally.
VITE_ENABLE_ACCOUNTS=false
